@using BTCPayServer.Plugins.BTCMap.Models
@model BtcMapListingViewModel
@{
    var storeId = Context.GetRouteValue("storeId")?.ToString();
    var osmAppRegistrationUrl = Model.IsMainnet
        ? "https://www.openstreetmap.org/oauth2/applications/new"
        : "https://master.apis.dev.openstreetmap.org/oauth2/applications/new";
    var osmAppListUrl = Model.IsMainnet
        ? "https://www.openstreetmap.org/oauth2/applications"
        : "https://master.apis.dev.openstreetmap.org/oauth2/applications";
    var osmSignupUrl = Model.IsMainnet
        ? "https://www.openstreetmap.org/user/new"
        : "https://master.apis.dev.openstreetmap.org/user/new";
    var redirectUri = Model.RedirectUriToShow ?? string.Empty;
}

<div class="card mb-4" id="osm-connect">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h4 class="mb-0">OpenStreetMap Connection</h4>
        @switch (Model.OsmState)
        {
            case OsmConnectionState.Connected:
                <span class="badge text-bg-success">Connected</span>
                break;
            case OsmConnectionState.ConfiguredNotConnected:
                <span class="badge text-bg-warning">Not connected</span>
                break;
            case OsmConnectionState.PendingExpired:
                <span class="badge text-bg-secondary">Pending expired</span>
                break;
            case OsmConnectionState.ConnectionError:
                <span class="badge text-bg-danger">Error</span>
                break;
            default:
                <span class="badge text-bg-secondary">Not configured</span>
                break;
        }
    </div>
    <div class="card-body">

        @if (Model.OsmState == OsmConnectionState.Connected)
        {
            <p class="mb-2">
                Connected as <strong>@Model.OsmUsername</strong>.
                @if (Model.OsmConnectedAt.HasValue)
                {
                    <span class="text-muted small">since @Model.OsmConnectedAt.Value.ToString("yyyy-MM-dd")</span>
                }
            </p>
            <p class="text-secondary small mb-3">
                Edits to OpenStreetMap from this store will be attributed to your OSM account. Please follow OSM's
                <a href="https://wiki.openstreetmap.org/wiki/Automated_Edits_code_of_conduct" target="_blank" rel="noopener noreferrer">Automated Edits Code of Conduct</a>
                and community guidelines.
            </p>
            <form method="post" asp-action="DisconnectOsm" asp-route-storeId="@storeId">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger"
                        onclick="return confirm('Disconnect your OpenStreetMap account from this store?');">
                    Disconnect
                </button>
            </form>
        }
        else if (Model.OsmState == OsmConnectionState.ConfiguredNotConnected)
        {
            <p class="mb-2">OSM credentials are saved. Click Connect to authorize.</p>
            <dl class="row mb-3 small">
                <dt class="col-sm-3">Client ID</dt>
                <dd class="col-sm-9 font-monospace">@Model.OsmClientIdMasked</dd>
                <dt class="col-sm-3">Client Secret</dt>
                <dd class="col-sm-9">••••••••</dd>
                <dt class="col-sm-3">Redirect URI</dt>
                <dd class="col-sm-9 font-monospace small text-break">@redirectUri</dd>
            </dl>

            <form method="post" asp-action="ConnectOsm" asp-route-storeId="@storeId" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Connect to OpenStreetMap</button>
            </form>
            <form method="post" asp-action="ClearOsmCredentials" asp-route-storeId="@storeId" class="d-inline ms-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary"
                        onclick="return confirm('Clear saved OSM credentials and start over?');">
                    Clear and start over
                </button>
            </form>
        }
        else if (Model.OsmState == OsmConnectionState.PendingExpired)
        {
            <div class="alert alert-warning mb-3">
                Your OAuth flow took longer than 10 minutes. Please click Connect again.
            </div>
            <form method="post" asp-action="ConnectOsm" asp-route-storeId="@storeId">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Connect to OpenStreetMap</button>
            </form>
        }
        else if (Model.OsmState == OsmConnectionState.ConnectionError)
        {
            <div class="alert alert-danger mb-3">
                @switch (Model.OsmErrorKind)
                {
                    case OsmConnectionErrorKind.RedirectUriMismatch:
                        <strong>OpenStreetMap rejected the redirect URI.</strong>
                        <p class="mb-1 mt-2">Open your OSM app's settings page and confirm the Redirect URI field matches this string exactly:</p>
                        <code class="d-block text-break my-2">@redirectUri</code>
                        <p class="mb-0 small">Trailing slashes and <code>http</code> vs <code>https</code> matter.</p>
                        break;
                    case OsmConnectionErrorKind.InvalidClient:
                        <strong>OpenStreetMap rejected the Client ID or Client Secret.</strong>
                        <p class="mb-0 mt-2">Either the values were copied incorrectly, or the secret was rotated on OSM. Click "Clear and start over" below and re-paste from your OSM app's settings page.</p>
                        break;
                    case OsmConnectionErrorKind.PublicAppNotConfidential:
                        <strong>Your OSM app is registered as <em>public</em>, but this plugin requires a <em>confidential</em> application.</strong>
                        <p class="mb-0 mt-2">On your <a href="@osmAppListUrl" target="_blank" rel="noopener noreferrer">OSM app's settings page</a>, edit the app and tick the "Confidential application" checkbox. Then return here and click Connect again.</p>
                        break;
                    case OsmConnectionErrorKind.AccessDenied:
                        <strong>You declined to authorize the app on OpenStreetMap.</strong>
                        <p class="mb-0 mt-2">Click Connect again if you want to retry.</p>
                        break;
                    default:
                        <strong>OAuth flow failed.</strong>
                        @if (!string.IsNullOrEmpty(Model.OsmErrorMessage))
                        {
                            <p class="mb-0 mt-2">@Model.OsmErrorMessage</p>
                        }
                        break;
                }
            </div>

            <form method="post" asp-action="ConnectOsm" asp-route-storeId="@storeId" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Try again</button>
            </form>
            <form method="post" asp-action="ClearOsmCredentials" asp-route-storeId="@storeId" class="d-inline ms-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary"
                        onclick="return confirm('Clear saved OSM credentials and start over?');">
                    Clear and start over
                </button>
            </form>
        }
        else
        {
            <p class="text-secondary mb-3">
                To list your business on OpenStreetMap from this store, register an OSM OAuth application
                with your own OSM account. This takes about 2&ndash;3 minutes if you already have an OSM account,
                or 10&ndash;15 minutes if you need to create one.
            </p>

            <details class="mb-3">
                <summary><strong>How to set up your OSM OAuth app</strong></summary>
                <ol class="mt-2 small">
                    <li class="mb-3">
                        <strong>Do you have an OpenStreetMap account?</strong>
                        <ul>
                            <li>If yes, go to step 2.</li>
                            <li>If no, <a href="@osmSignupUrl" target="_blank" rel="noopener noreferrer">create one here</a>. Use any email — the account is for tagging your merchant location, not personal data. After signing up, <strong>verify your email</strong> (OSM requires a verified email for OAuth app registration).</li>
                        </ul>
                    </li>
                    <li class="mb-3">
                        <strong>Register an OAuth application on OpenStreetMap.</strong>
                        <p class="mb-1"><a href="@osmAppRegistrationUrl" target="_blank" rel="noopener noreferrer">Open the registration form</a> (logged in to your OSM account). Fill in the form exactly as follows:</p>
                        <ul>
                            <li><strong>Name:</strong> anything you'll recognize, e.g. <code>BTCPay BTC Map &mdash; my-store-name</code></li>
                            <li><strong>Redirect URIs:</strong> paste this string <em>exactly</em>:
                                <pre class="bg-body-secondary p-2 small text-break my-1"><code>@redirectUri</code></pre>
                            </li>
                            <li><strong>Confidential application?</strong> &mdash; <strong>CHECKED</strong>. Required.</li>
                            <li><strong>Permissions / Scopes:</strong> check exactly these two boxes (leave the rest unchecked):
                                <ul>
                                    <li><code>Modify the map (write_api)</code></li>
                                    <li><code>Read user preferences (read_prefs)</code></li>
                                </ul>
                            </li>
                        </ul>
                        <p class="mb-1">Click <em>Register</em>.</p>
                    </li>
                    <li class="mb-3">
                        <strong>Copy your Client ID and Client Secret back here.</strong>
                        <p class="mb-1">OSM will show you a Client ID and a Client Secret immediately after registration.
                            <strong>The secret is only shown once.</strong> If you lose it, click "Reset secret" on the OSM
                            app's settings page to generate a new one.</p>
                    </li>
                </ol>
                <details class="mt-3">
                    <summary class="small">If something doesn't work</summary>
                    <ul class="small mt-1">
                        <li><strong>Redirect URI mismatch:</strong> the URI on OSM doesn't match the one above. Check trailing slashes and http vs https.</li>
                        <li><strong>Invalid client:</strong> Client ID or Secret was copied incorrectly, or the secret was rotated on OSM.</li>
                        <li><strong>Public/confidential mismatch:</strong> the "Confidential application" checkbox wasn't ticked on OSM.</li>
                        <li><strong>Access denied:</strong> you clicked Cancel instead of Authorize on OSM.</li>
                    </ul>
                </details>
            </details>

            <form method="post" asp-action="SaveOsmCredentials" asp-route-storeId="@storeId">
                @Html.AntiForgeryToken()
                <div class="form-group mb-3">
                    <label class="form-label small text-secondary">Redirect URI to paste into OSM</label>
                    <div class="input-group">
                        <input type="text" id="osm-redirect-uri" class="form-control font-monospace small"
                               value="@redirectUri" readonly />
                        <button type="button" class="btn btn-outline-secondary" id="osm-redirect-uri-copy">Copy</button>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="OsmCredentials.OsmClientId" class="form-label">OSM Client ID <span class="text-danger">*</span></label>
                    <input asp-for="OsmCredentials.OsmClientId" class="form-control font-monospace" required />
                    <span asp-validation-for="OsmCredentials.OsmClientId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="OsmCredentials.OsmClientSecret" class="form-label">OSM Client Secret <span class="text-danger">*</span></label>
                    <input asp-for="OsmCredentials.OsmClientSecret" type="password" class="form-control font-monospace" required autocomplete="off" />
                    <span asp-validation-for="OsmCredentials.OsmClientSecret" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save credentials</button>
            </form>

            <script>
                (function () {
                    var btn = document.getElementById('osm-redirect-uri-copy');
                    var inp = document.getElementById('osm-redirect-uri');
                    if (!btn || !inp) return;
                    btn.addEventListener('click', function () {
                        inp.select();
                        try { document.execCommand('copy'); } catch (e) { /* ignore */ }
                        btn.textContent = 'Copied!';
                        setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
                    });
                })();
            </script>
        }
    </div>
</div>
